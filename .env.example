# Environment Variables for StratoONE Chat Module

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chat_module?schema=public"

# Cloudflare R2 Storage (Compatible with existing R2_Storage_Module & Fortune Storage App)
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="fortune-chat-media"
R2_BUCKET_PREFIX="fortune-"
R2_PUBLIC_BASE_URL="https://storage.fortune.app"
R2_PUBLIC="false"

# Application / WebSocket
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
WS_PORT=3001
JWT_SECRET="super-secret-jwt-key"
